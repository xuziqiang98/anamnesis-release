58675.     ta = p->u.typed_array;
58676.     abuf = ta->buffer->u.array_buffer;
58677.     if (!abuf->shared) {
58678.         if (is_waitable == 2) {
58679.             JS_ThrowTypeError(ctx, "not a SharedArrayBuffer TypedArray");
58680.             return -1;
58681.         }
58682.         if (abuf->detached) {
58683.             JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
58684.             return -1;
58685.         }
58686.     }
58687.     old_len = p->u.array.count;
58688.     
58689.     if (JS_ToIndex(ctx, &idx, idx_val)) {
58690.         return -1;
58691.     }
58692. 
58693.     if (idx >= old_len)
58694.         goto oob;
58695. 
58696.     if (is_waitable == 1) {
58697.         /* notify(): just avoid having an invalid pointer if overflow */
58698.         if (idx >= p->u.array.count)
