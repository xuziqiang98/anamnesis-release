873. static JSValue js_evalScript(JSContext *ctx, JSValueConst this_val,
874.                              int argc, JSValueConst *argv)
875. {
876.     JSRuntime *rt = JS_GetRuntime(ctx);
877.     JSThreadState *ts = JS_GetRuntimeOpaque(rt);
878.     const char *str;
879.     size_t len;
880.     JSValue ret;
881.     JSValueConst options_obj;
882.     BOOL backtrace_barrier = FALSE;
883.     BOOL is_async = FALSE;
884.     int flags;
885. 
886.     if (argc >= 2) {
887.         options_obj = argv[1];
888.         if (get_bool_option(ctx, &backtrace_barrier, options_obj,
889.                             "backtrace_barrier"))
890.             return JS_EXCEPTION;
891.         if (get_bool_option(ctx, &is_async, options_obj,
892.                             "async"))
893.             return JS_EXCEPTION;
894.     }
895. 
896.     str = JS_ToCStringLen(ctx, &len, argv[0]);
897.     if (!str)
898.         return JS_EXCEPTION;
899.     if (!ts->recv_pipe && ++ts->eval_script_recurse == 1) {
900.         /* install the interrupt handler */
901.         JS_SetInterruptHandler(JS_GetRuntime(ctx), interrupt_handler, NULL);
902.     }
903.     flags = JS_EVAL_TYPE_GLOBAL;
904.     if (backtrace_barrier)
905.         flags |= JS_EVAL_FLAG_BACKTRACE_BARRIER;
906.     if (is_async)
907.         flags |= JS_EVAL_FLAG_ASYNC;
908.     ret = JS_Eval(ctx, str, len, "<evalScript>", flags);
909.     JS_FreeCString(ctx, str);
910.     if (!ts->recv_pipe && --ts->eval_script_recurse == 0) {
911.         /* remove the interrupt handler */
912.         JS_SetInterruptHandler(JS_GetRuntime(ctx), NULL, NULL);
913.         os_pending_signals &= ~((uint64_t)1 << SIGINT);
914.         /* convert the uncatchable "interrupted" error into a normal error
915.            so that it can be caught by the REPL */
916.         if (JS_IsException(ret))
917.             JS_SetUncatchableException(ctx, FALSE);
918.     }
919.     return ret;
920. }

