4030. const char *JS_ToCStringLen2(JSContext *ctx, size_t *plen, JSValueConst val1, BOOL cesu8)
4031. {
4032.     JSValue val;
4033.     JSString *str, *str_new;
4034.     int pos, len, c, c1;
4035.     uint8_t *q;
4036. 
4037.     if (JS_VALUE_GET_TAG(val1) != JS_TAG_STRING) {
4038.         val = JS_ToString(ctx, val1);
4039.         if (JS_IsException(val))
4040.             goto fail;
4041.     } else {
4042.         val = JS_DupValue(ctx, val1);
4043.     }
4044. 
4045.     str = JS_VALUE_GET_STRING(val);
4046.     len = str->len;
4047.     if (!str->is_wide_char) {
4048.         const uint8_t *src = str->u.str8;
4049.         int count;
4050. 
4051.         /* count the number of non-ASCII characters */
4052.         /* Scanning the whole string is required for ASCII strings,
4053.            and computing the number of non-ASCII bytes is less expensive
4054.            than testing each byte, hence this method is faster for ASCII
4055.            strings, which is the most common case.
4056.          */
4057.         count = 0;
4058.         for (pos = 0; pos < len; pos++) {
4059.             count += src[pos] >> 7;
4060.         }
4061.         if (count == 0) {
4062.             if (plen)
4063.                 *plen = len;
4064.             return (const char *)src;
4065.         }
4066.         str_new = js_alloc_string(ctx, len + count, 0);
4067.         if (!str_new)
4068.             goto fail;
4069.         q = str_new->u.str8;
4070.         for (pos = 0; pos < len; pos++) {
4071.             c = src[pos];
4072.             if (c < 0x80) {
4073.                 *q++ = c;
4074.             } else {
4075.                 *q++ = (c >> 6) | 0xc0;
4076.                 *q++ = (c & 0x3f) | 0x80;
4077.             }
4078.         }
4079.     } else {
4080.         const uint16_t *src = str->u.str16;
4081.         /* Allocate 3 bytes per 16 bit code point. Surrogate pairs may
4082.            produce 4 bytes but use 2 code points.
4083.          */
4084.         str_new = js_alloc_string(ctx, len * 3, 0);
4085.         if (!str_new)
4086.             goto fail;
4087.         q = str_new->u.str8;
4088.         pos = 0;
4089.         while (pos < len) {
4090.             c = src[pos++];
4091.             if (c < 0x80) {
4092.                 *q++ = c;
4093.             } else {
4094.                 if (is_hi_surrogate(c)) {
4095.                     if (pos < len && !cesu8) {
4096.                         c1 = src[pos];
4097.                         if (is_lo_surrogate(c1)) {
4098.                             pos++;
4099.                             c = from_surrogate(c, c1);
4100.                         } else {
4101.                             /* Keep unmatched surrogate code points */
4102.                             /* c = 0xfffd; */ /* error */
4103.                         }
4104.                     } else {
4105.                         /* Keep unmatched surrogate code points */
4106.                         /* c = 0xfffd; */ /* error */
4107.                     }
4108.                 }
4109.                 q += unicode_to_utf8(q, c);
4110.             }
4111.         }
4112.     }
4113. 
4114.     *q = '\0';
4115.     str_new->len = q - str_new->u.str8;
4116.     JS_FreeValue(ctx, val);
4117.     if (plen)
4118.         *plen = str_new->len;
4119.     return (const char *)str_new->u.str8;
4120.  fail:
4121.     if (plen)
