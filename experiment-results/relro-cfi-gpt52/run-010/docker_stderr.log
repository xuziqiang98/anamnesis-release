56096.             // TODO(bnoordhuis) support externally managed RABs
56097.             if (abuf->free_func == js_array_buffer_free)
56098.                 pmax_len = &max_len;
56099.         }
56100.     }
56101.     /* create an empty AB */
56102.     if (new_len == 0) {
56103.         JS_DetachArrayBuffer(ctx, this_val);
56104.         return js_array_buffer_constructor2(ctx, JS_UNDEFINED, 0, pmax_len, JS_CLASS_ARRAY_BUFFER);
56105.     } else {
56106.         uint64_t old_len;
56107.         uint8_t *bs, *new_bs;
56108.         JSFreeArrayBufferDataFunc *free_func;
56109.         
56110.         bs = abuf->data;
56111.         old_len = abuf->byte_length;
56112.         free_func = abuf->free_func;
56113. 
56114.         /* if length mismatch, realloc. Otherwise, use the same backing buffer. */
56115.         if (new_len != old_len) {
