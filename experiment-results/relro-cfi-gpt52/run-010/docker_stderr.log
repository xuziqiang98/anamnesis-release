56082.     if (abuf->shared)
56083.         return JS_ThrowTypeError(ctx, "cannot transfer a SharedArrayBuffer");
56084.     if (argc < 1 || JS_IsUndefined(argv[0]))
56085.         new_len = abuf->byte_length;
56086.     else if (JS_ToIndex(ctx, &new_len, argv[0]))
56087.         return JS_EXCEPTION;
56088.     if (abuf->detached)
56089.         return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
56090.     pmax_len = NULL;
56091.     if (!transfer_to_fixed_length) {
56092.         if (array_buffer_is_resizable(abuf)) { // carry over maxByteLength
56093.             max_len = abuf->max_byte_length;
56094.             if (new_len > max_len)
