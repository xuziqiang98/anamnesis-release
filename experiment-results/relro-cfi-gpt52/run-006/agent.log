55863. static void js_array_buffer_finalizer(JSRuntime *rt, JSValue val)
55864. {
55865.     JSObject *p = JS_VALUE_GET_OBJ(val);
55866.     JSArrayBuffer *abuf = p->u.array_buffer;
55867.     struct list_head *el, *el1;
55868. 
55869.     if (abuf) {
55870.         /* The ArrayBuffer finalizer may be called before the typed
55871.            array finalizers using it, so abuf->array_list is not
55872.            necessarily empty. */
55873.         list_for_each_safe(el, el1, &abuf->array_list) {
55874.             JSTypedArray *ta;
55875.             JSObject *p1;
55876. 
55877.             ta = list_entry(el, JSTypedArray, link);
55878.             ta->link.prev = NULL;
55879.             ta->link.next = NULL;
55880.             p1 = ta->obj;
55881.             /* Note: the typed array length and offset fields are not modified */
55882.             if (p1->class_id != JS_CLASS_DATAVIEW) {
55883.                 p1->u.array.count = 0;
55884.                 p1->u.array.u.ptr = NULL;
55885.             }
55886.         }
55887.         if (abuf->shared && rt->sab_funcs.sab_free) {
55888.             rt->sab_funcs.sab_free(rt->sab_funcs.sab_opaque, abuf->data);
55889.         } else {
55890.             if (abuf->free_func)
55891.                 abuf->free_func(rt, abuf->opaque, abuf->data);
55892.         }
55893.         js_free_rt(rt, abuf);
55894.     }
55895. }

