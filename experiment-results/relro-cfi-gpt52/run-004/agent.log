    33  cp "$SRC"/*.c . 2>/dev/null || true
    34  cp "$SRC"/*.h . 2>/dev/null || true
    35  cp "$SRC"/*.js . 2>/dev/null || true
    36  cp "$SRC"/Makefile .
    37  cp "$SRC"/VERSION . 2>/dev/null || echo "2025-01-10" > VERSION
    38  
    39  echo "Applying CFI compatibility patches..."
    40  
    41  # ==== PATCH 1: Add CFI-compatible wrapper to quickjs.c ====
    42  # Find js_realloc_rt and add wrapper after it (NON-static so quickjs-libc.c can use it)
    43  FUNC_LINE=$(grep -n "^void \*js_realloc_rt(JSRuntime" quickjs.c | cut -d: -f1)
    44  INSERT_LINE=$((FUNC_LINE + 4))
    45  
    46  cat > /tmp/cfi_wrapper.txt << 'WRAPPER'
    47  
    48  /* CFI-compatible wrapper for js_realloc_rt.
    49   * This wrapper has the DynBufReallocFunc signature (void* first param)
    50   * instead of JSRuntime*, making it compatible with strict CFI type checking.
    51   * Non-static so it can be used from quickjs-libc.c as well.
    52   */
    53  void *js_realloc_rt_dynbuf(void *opaque, void *ptr, size_t size)
    54  {
    55      JSRuntime *rt = opaque;
    56      return js_realloc_rt(rt, ptr, size);
    57  }
    58  WRAPPER
    59  
    60  head -n "$INSERT_LINE" quickjs.c > /tmp/quickjs_patched.c
    61  cat /tmp/cfi_wrapper.txt >> /tmp/quickjs_patched.c
    62  tail -n +"$((INSERT_LINE + 1))" quickjs.c >> /tmp/quickjs_patched.c
    63  mv /tmp/quickjs_patched.c quickjs.c
    64  
    65  # Replace type-unsafe casts in quickjs.c
    66  sed -i 's/(DynBufReallocFunc \*)js_realloc_rt/js_realloc_rt_dynbuf/g' quickjs.c
    67  echo "  - Patched quickjs.c"
    68  
    69  # ==== PATCH 2: Add declaration to quickjs.h ====
    70  # Insert after the js_realloc_rt declaration
    71  sed -i '/^void \*js_realloc_rt(JSRuntime \*rt, void \*ptr, size_t size);$/a void *js_realloc_rt_dynbuf(void *opaque, void *ptr, size_t size);' quickjs.h
    72  echo "  - Patched quickjs.h"
    73  
    74  # ==== PATCH 3: Fix quickjs-libc.c ====
    75  # Replace type-unsafe casts in quickjs-libc.c
    76  sed -i 's/(DynBufReallocFunc \*)js_realloc_rt/js_realloc_rt_dynbuf/g' quickjs-libc.c
    77  echo "  - Patched quickjs-libc.c"
    78  
    79  echo "All patches applied. Building..."
    80  
    81  # Create Makefile configuration for strict CFI
    82  cat > Makefile.local << 'MAKELOCAL'
    83  CONFIG_CLANG=y
    84  CONFIG_LTO=y
    85  CFLAGS+=-fsanitize=cfi-icall -fvisibility=hidden
    86  LDFLAGS+=-fsanitize=cfi-icall -fuse-ld=lld -Wl,-z,relro,-z,now
    87  MAKELOCAL
    88  
    89  # Include local config
    90  if ! grep -q "Makefile.local" Makefile; then
    91      sed -i '1i-include Makefile.local' Makefile
    92  fi
    93  
    94  # Build
    95  make clean 2>/dev/null || true
    96  make -j4 qjsc
    97  ./qjsc -s -c -o repl.c -m repl.js
    98  make -j4 qjs
    99  
   100  # Install
