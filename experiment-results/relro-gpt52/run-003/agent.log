58725. static JSValue js_atomics_op(JSContext *ctx,
58726.                              JSValueConst this_obj,
58727.                              int argc, JSValueConst *argv, int op)
58728. {
58729.     int size_log2;
58730.     uint64_t v, a, rep_val;
58731.     void *ptr;
58732.     JSValue ret;
58733.     JSClassID class_id;
58734.     JSArrayBuffer *abuf;
58735. 
58736.     if (js_atomics_get_ptr(ctx, &ptr, &abuf, &size_log2, &class_id,
58737.                            argv[0], argv[1], 0))
58738.         return JS_EXCEPTION;
58739.     rep_val = 0;
58740.     if (op == ATOMICS_OP_LOAD) {
58741.         v = 0;
