58748.             if (op == ATOMICS_OP_COMPARE_EXCHANGE) {
58749.                 if (JS_ToBigInt64(ctx, &v64, argv[3]))
58750.                     return JS_EXCEPTION;
58751.                 rep_val = v64;
58752.             }
58753.         } else {
58754.                 uint32_t v32;
58755.                 if (JS_ToUint32(ctx, &v32, argv[2]))
58756.                     return JS_EXCEPTION;
