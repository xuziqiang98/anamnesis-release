58762.                 }
58763.         }
58764.         if (abuf->detached)
58765.             return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
58766.    }
58767. 
58768.    switch(op | (size_log2 << 3)) {
58769. 
58770. #define OP(op_name, func_name)                          \
58771.     case ATOMICS_OP_ ## op_name | (0 << 3):             \
58772.        a = func_name((_Atomic(uint8_t) *)ptr, v);       \
58773.        break;                                           \
58774.     case ATOMICS_OP_ ## op_name | (1 << 3):             \
58775.         a = func_name((_Atomic(uint16_t) *)ptr, v);     \
58776.         break;                                          \
58777.     case ATOMICS_OP_ ## op_name | (2 << 3):             \
58778.         a = func_name((_Atomic(uint32_t) *)ptr, v);     \
58779.         break;                                          \
58780.     case ATOMICS_OP_ ## op_name | (3 << 3):             \
58781.         a = func_name((_Atomic(uint64_t) *)ptr, v);     \
58782.         break;
58783. 
58784.         OP(ADD, atomic_fetch_add)
58785.         OP(AND, atomic_fetch_and)
58786.         OP(OR, atomic_fetch_or)
58787.         OP(SUB, atomic_fetch_sub)
58788.         OP(XOR, atomic_fetch_xor)
58789.         OP(EXCHANGE, atomic_exchange)
58790. #undef OP
58791. 
58792.     case ATOMICS_OP_LOAD | (0 << 3):
58793.         a = atomic_load((_Atomic(uint8_t) *)ptr);
58794.         break;
58795.     case ATOMICS_OP_LOAD | (1 << 3):
58796.         a = atomic_load((_Atomic(uint16_t) *)ptr);
58797.         break;
58798.     case ATOMICS_OP_LOAD | (2 << 3):
58799.         a = atomic_load((_Atomic(uint32_t) *)ptr);
58800.         break;
58801.     case ATOMICS_OP_LOAD | (3 << 3):
58802.         a = atomic_load((_Atomic(uint64_t) *)ptr);
58803.         break;
58804. 
58805.     case ATOMICS_OP_COMPARE_EXCHANGE | (0 << 3):
58806.         {
58807.             uint8_t v1 = v;
58808.             atomic_compare_exchange_strong((_Atomic(uint8_t) *)ptr, &v1, rep_val);
58809.             a = v1;
58810.         }
58811.         break;
58812.     case ATOMICS_OP_COMPARE_EXCHANGE | (1 << 3):
58813.         {
58814.             uint16_t v1 = v;
58815.             atomic_compare_exchange_strong((_Atomic(uint16_t) *)ptr, &v1, rep_val);
58816.             a = v1;
58817.         }
58818.         break;
58819.     case ATOMICS_OP_COMPARE_EXCHANGE | (2 << 3):
58820.         {
58821.             uint32_t v1 = v;
58822.             atomic_compare_exchange_strong((_Atomic(uint32_t) *)ptr, &v1, rep_val);
58823.             a = v1;
58824.         }
58825.         break;
58826.     case ATOMICS_OP_COMPARE_EXCHANGE | (3 << 3):
58827.         {
58828.             uint64_t v1 = v;
58829.             atomic_compare_exchange_strong((_Atomic(uint64_t) *)ptr, &v1, rep_val);
58830.             a = v1;
58831.         }
58832.         break;
58833.     default:
58834.         abort();
58835.     }
58836. 
58837.     switch(class_id) {
58838.     case JS_CLASS_INT8_ARRAY:
58839.         a = (int8_t)a;
58840.         goto done;
58841.     case JS_CLASS_UINT8_ARRAY:
58842.         a = (uint8_t)a;
58843.         goto done;
58844.     case JS_CLASS_INT16_ARRAY:
58845.         a = (int16_t)a;
58846.         goto done;
58847.     case JS_CLASS_UINT16_ARRAY:
58848.         a = (uint16_t)a;
58849.         goto done;
58850.     case JS_CLASS_INT32_ARRAY:
58851.     done:
58852.         ret = JS_NewInt32(ctx, a);
58853.         break;
58854.     case JS_CLASS_UINT32_ARRAY:
58855.         ret = JS_NewUint32(ctx, a);
58856.         break;
58857.     case JS_CLASS_BIG_INT64_ARRAY:
58858.         ret = JS_NewBigInt64(ctx, a);
58859.         break;
58860.     case JS_CLASS_BIG_UINT64_ARRAY:
58861.         ret = JS_NewBigUint64(ctx, a);
58862.         break;
58863.     default:
58864.         abort();
58865.     }
