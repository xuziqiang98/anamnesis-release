55727.     abuf->byte_length = len;
55728.     abuf->max_byte_length = max_len ? *max_len : -1;
55729.     if (alloc_flag) {
55730.         if (class_id == JS_CLASS_SHARED_ARRAY_BUFFER &&
55731.             rt->sab_funcs.sab_alloc) {
55732.             // TOOD(bnoordhuis) resizing backing memory for SABs atomically
55733.             // is hard so we cheat and allocate |maxByteLength| bytes upfront
55734.             sab_alloc_len = max_len ? *max_len : len;
55735.             abuf->data = rt->sab_funcs.sab_alloc(rt->sab_funcs.sab_opaque,
55736.                                                  max_int(sab_alloc_len, 1));
