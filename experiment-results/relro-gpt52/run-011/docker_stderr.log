58716.         *pabuf = abuf;
58717.     if (psize_log2)
58718.         *psize_log2 = size_log2;
58719.     if (pclass_id)
58720.         *pclass_id = p->class_id;
58721.     *pptr = ptr;
58722.     return 0;
