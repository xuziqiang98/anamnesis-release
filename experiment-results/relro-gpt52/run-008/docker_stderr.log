5347. static JSValue JS_NewObjectProtoClassAlloc(JSContext *ctx, JSValueConst proto_val,
5348.                                            JSClassID class_id, int n_alloc_props)
5349. {
5350.     JSShape *sh;
5351.     JSObject *proto;
5352.     int hash_size, hash_bits;
5353.     
5354.     if (n_alloc_props <= JS_PROP_INITIAL_SIZE) {
5355.         n_alloc_props = JS_PROP_INITIAL_SIZE;
5356.         hash_size = JS_PROP_INITIAL_HASH_SIZE;
5357.     } else {
5358.         hash_bits = 32 - clz32(n_alloc_props - 1); /* ceil(log2(radix)) */
5359.         hash_size = 1 << hash_bits;
5360.     }
5361.     proto = get_proto_obj(proto_val);
5362.     sh = js_new_shape_nohash(ctx, proto, hash_size, n_alloc_props);
5363.     if (!sh)
5364.         return JS_EXCEPTION;
5365.     return JS_NewObjectFromShape(ctx, sh, class_id, NULL);
5366. }

