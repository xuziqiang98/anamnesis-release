56151. static JSValue js_array_buffer_resize(JSContext *ctx, JSValueConst this_val,
56152.                                       int argc, JSValueConst *argv, int class_id)
56153. {
56154.     JSArrayBuffer *abuf;
56155.     uint8_t *data;
56156.     int64_t len;
56157. 
56158.     abuf = JS_GetOpaque2(ctx, this_val, class_id);
56159.     if (!abuf)
56160.         return JS_EXCEPTION;
56161.     if (JS_ToInt64(ctx, &len, argv[0]))
56162.         return JS_EXCEPTION;
56163.     if (abuf->detached)
56164.         return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
56165.     if (!array_buffer_is_resizable(abuf))
56166.         return JS_ThrowTypeError(ctx, "array buffer is not resizable");
56167.     // TODO(bnoordhuis) support externally managed RABs
56168.     if (abuf->free_func != js_array_buffer_free)
56169.         return JS_ThrowTypeError(ctx, "external array buffer is not resizable");
56170.     if (len < 0 || len > abuf->max_byte_length) {
56171.     bad_length:
56172.         return JS_ThrowRangeError(ctx, "invalid array buffer length");
56173.     }
56174.     // SABs can only grow and we don't need to realloc because
56175.     // js_array_buffer_constructor3 commits all memory upfront;
56176.     // regular RABs are resizable both ways and realloc
56177.     if (abuf->shared) {
56178.         if (len < abuf->byte_length)
56179.             goto bad_length;
56180.         // Note this is off-spec; there's supposed to be a single atomic
56181.         // |byteLength| property that's shared across SABs but we store
56182.         // it per SAB instead. That means when thread A calls sab.grow(2)
56183.         // at time t0, and thread B calls sab.grow(1) at time t1, we don't
56184.         // throw a TypeError in thread B as the spec says we should,
56185.         // instead both threads get their own view of the backing memory,
56186.         // 2 bytes big in A, and 1 byte big in B
56187.         abuf->byte_length = len;
56188.     } else {
56189.         data = js_realloc(ctx, abuf->data, max_int(len, 1));
56190.         if (!data)
56191.             return JS_EXCEPTION;
56192.         if (len > abuf->byte_length)
56193.             memset(&data[abuf->byte_length], 0, len - abuf->byte_length);
56194.         abuf->byte_length = len;
56195.         abuf->data = data;
56196.     }
56197.     js_array_buffer_update_typed_arrays(abuf);
56198.     return JS_UNDEFINED;
56199. }

