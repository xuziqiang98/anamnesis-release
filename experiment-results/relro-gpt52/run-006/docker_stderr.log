55692. static JSValue js_array_buffer_constructor3(JSContext *ctx,
55693.                                             JSValueConst new_target,
55694.                                             uint64_t len, uint64_t *max_len,
55695.                                             JSClassID class_id,
55696.                                             uint8_t *buf,
55697.                                             JSFreeArrayBufferDataFunc *free_func,
55698.                                             void *opaque, BOOL alloc_flag)
55699. {
55700.     JSRuntime *rt = ctx->rt;
55701.     JSValue obj;
55702.     JSArrayBuffer *abuf = NULL;
55703.     uint64_t sab_alloc_len;
55704. 
55705.     if (!alloc_flag && buf && max_len && free_func != js_array_buffer_free) {
55706.         // not observable from JS land, only through C API misuse;
55707.         // JS code cannot create externally managed buffers directly
55708.         return JS_ThrowInternalError(ctx,
55709.                                      "resizable ArrayBuffers not supported "
55710.                                      "for externally managed buffers");
55711.     }
55712.     obj = js_create_from_ctor(ctx, new_target, class_id);
55713.     if (JS_IsException(obj))
55714.         return obj;
55715.     /* XXX: we are currently limited to 2 GB */
55716.     if (len > INT32_MAX) {
55717.         JS_ThrowRangeError(ctx, "invalid array buffer length");
55718.         goto fail;
55719.     }
55720.     if (max_len && *max_len > INT32_MAX) {
55721.         JS_ThrowRangeError(ctx, "invalid max array buffer length");
55722.         goto fail;
55723.     }
55724.     abuf = js_malloc(ctx, sizeof(*abuf));
55725.     if (!abuf)
