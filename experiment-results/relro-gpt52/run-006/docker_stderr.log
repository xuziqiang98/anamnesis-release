    23	            if (isfinite(d))
    24	                if (0 == modf(d, &d))
    25	                    break;
    26	            // fallthru
    27	        default:
    28	            return JS_ThrowTypeError(ctx, "not an integral number");
    29	        case JS_TAG_UNDEFINED:
    30	        case JS_TAG_INT:
    31	            break;
    32	        }
    33	    }
    34	    cpu_pause();
    35	    return JS_UNDEFINED;
    36	}
