2026-01-11 14:56:43,019 - INFO - Tool result:      1  #!/bin/bash
     2  # heap_size.sh - Show what code allocates N bytes
     3  #
     4  # Usage: heap_size.sh <size>
     5  #
     6  # For each malloc(N) call in the trace, shows the complete call stack
     7  # leading to that allocation. This answers "what allocates N bytes?"
     8  #
     9  # Example: heap_size.sh 56
    10  #   Shows: main() -> ... -> js_array_buffer_constructor3() -> js_malloc() -> malloc(56)
    11  #
    12  # Run heap_trace.sh first to record a trace
    13  
    14  SIZE="$1"
    15  if [ -z "$SIZE" ]; then
    16      echo "Usage: heap_size.sh <size>" >&2
    17      echo "Shows the call stack for each malloc of the specified size" >&2
    18      exit 1
    19  fi
    20  
    21  if [ ! -d "/tmp/uftrace.data" ]; then
    22      echo "Error: No trace data found. Run heap_trace.sh first." >&2
    23      exit 1
    24  fi
    25  
    26  # Use -C malloc to get caller context, then use awk to track the call stack
    27  uftrace replay -d /tmp/uftrace.data -C malloc 2>&1 | awk '
    28  /malloc\('"$SIZE"'\)/ {
    29      print "=== Call stack for malloc('"$SIZE"') ==="
    30      for (i = 0; i < depth; i++) {
    31          printf "%s", prefix[i]
    32          print stack[i]
    33      }
    34      print $0
    35      print ""
    36  }
    37  /\(\) \{$/ {
    38      # Extract function name and add to stack
    39      match($0, /[a-zA-Z_][a-zA-Z0-9_]*\(\)/)
    40      stack[depth] = substr($0, RSTART, RLENGTH)
    41      # Capture indentation for pretty printing
    42      match($0, /^[^a-zA-Z]*/)
    43      prefix[depth] = substr($0, RSTART, RLENGTH)
    44      depth++
    45  }
    46  /\} \/\*/ {
    47      # Pop from stack
    48      if (depth > 0) depth--
    49  }'
