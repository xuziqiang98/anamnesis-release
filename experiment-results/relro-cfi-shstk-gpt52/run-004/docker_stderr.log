56311. static BOOL typed_array_is_oob(JSObject *p)
56312. {
56313.     JSArrayBuffer *abuf;
56314.     JSTypedArray *ta;
56315.     int len, size_elem;
56316.     int64_t end;
56317. 
56318.     assert(p->class_id >= JS_CLASS_UINT8C_ARRAY);
56319.     assert(p->class_id <= JS_CLASS_FLOAT64_ARRAY);
56320. 
56321.     ta = p->u.typed_array;
56322.     abuf = ta->buffer->u.array_buffer;
56323.     if (abuf->detached)
56324.         return TRUE;
56325.     len = abuf->byte_length;
56326.     if (ta->offset > len)
56327.         return TRUE;
56328.     if (ta->track_rab)
56329.         return FALSE;
56330.     if (len < (int64_t)ta->offset + ta->length)
56331.         return TRUE;
56332.     size_elem = 1 << typed_array_size_log2(p->class_id);
56333.     end = (int64_t)ta->offset + (int64_t)p->u.array.count * size_elem;
56334.     return end > len;
56335. }

