55974. static void js_array_buffer_update_typed_arrays(JSArrayBuffer *abuf)
55975. {
55976.     uint32_t size_log2, size_elem;
55977.     struct list_head *el;
55978.     JSTypedArray *ta;
55979.     JSObject *p;
55980.     uint8_t *data;
55981.     int64_t len;
55982. 
55983.     len = abuf->byte_length;
55984.     data = abuf->data;
55985.     // update lengths of all typed arrays backed by this array buffer
55986.     list_for_each(el, &abuf->array_list) {
55987.         ta = list_entry(el, JSTypedArray, link);
55988.         p = ta->obj;
55989.         if (p->class_id == JS_CLASS_DATAVIEW) {
55990.             if (ta->track_rab) {
55991.                 if (ta->offset < len)
55992.                     ta->length = len - ta->offset;
55993.                 else
55994.                     ta->length = 0;
55995.             }
55996.         } else {
55997.             p->u.array.count = 0;
55998.             p->u.array.u.ptr = NULL;
55999.             size_log2 = typed_array_size_log2(p->class_id);
56000.             size_elem = 1 << size_log2;
56001.             if (ta->track_rab) {
56002.                 if (len >= (int64_t)ta->offset + size_elem) {
56003.                     p->u.array.count = (len - ta->offset) >> size_log2;
56004.                     p->u.array.u.ptr = &data[ta->offset];
56005.                 }
56006.             } else {
56007.                 if (len >= (int64_t)ta->offset + ta->length) {
56008.                     p->u.array.count = ta->length >> size_log2;
56009.                     p->u.array.u.ptr = &data[ta->offset];
56010.                 }
56011.             }
56012.         }
56013.     }
56014.     
56015. }

