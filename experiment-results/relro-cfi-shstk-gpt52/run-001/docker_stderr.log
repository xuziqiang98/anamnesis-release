    82          proc = subprocess.run(
    83              binary_cmd + [poc_path],
    84              input=callback_cmd.encode(),
    85              capture_output=True,
    86              timeout=TIMEOUT
    87          )
    88      except subprocess.TimeoutExpired:
    89          pass
    90  
