#!/bin/bash
# =============================================================================
# Shell Exploit Verification via Network Callback (CET + CFI Binary)
# =============================================================================
#
# Usage: ./run_shell_verify_callback_cet_cfi.sh <poc.js>
#
# VERIFICATION PROTOCOL:
