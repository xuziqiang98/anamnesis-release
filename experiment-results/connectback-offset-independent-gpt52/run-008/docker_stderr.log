#!/bin/bash
# heap_trace.sh - Record heap operations (malloc/free/realloc) for analysis
#
# Usage: heap_trace.sh <input_file>
#
# Records a trace of all heap operations to /tmp/uftrace.data
# Use heap_replay.sh, heap_func.sh, heap_size.sh, or heap_addr.sh to analyze

set -e

INPUT="$1"
if [ -z "$INPUT" ]; then
    echo "Usage: heap_trace.sh <input_file>" >&2
    echo "Records heap operations to /tmp/uftrace.data" >&2
    exit 1
fi

if [ ! -f "$INPUT" ]; then
    echo "Error: Input file not found: $INPUT" >&2
    exit 1
fi

PROFILE_BINARY="/opt/evals/install-profile/evals-quickjs-latest/qjs"

if [ ! -x "$PROFILE_BINARY" ]; then
    echo "Error: Profile binary not found: $PROFILE_BINARY" >&2
    exit 1
fi

echo "Recording heap trace for: $INPUT"
uftrace record -d /tmp/uftrace.data \
    -P malloc -P free -P realloc \
    -A malloc@arg1 -R malloc@retval \
    -A free@arg1 \
    -A realloc@arg1,arg2 -R realloc@retval \
    "$PROFILE_BINARY" "$INPUT" 2>&1

echo "Trace saved to /tmp/uftrace.data"
echo "Use heap_replay.sh, heap_func.sh, heap_size.sh, or heap_addr.sh to analyze"

