20183. static JSValue js_create_from_ctor(JSContext *ctx, JSValueConst ctor,
20184.                                    int class_id)
20185. {
20186.     JSValue proto, obj;
20187.     JSContext *realm;
20188. 
20189.     if (JS_IsUndefined(ctor)) {
20190.         proto = JS_DupValue(ctx, ctx->class_proto[class_id]);
20191.     } else {
20192.         proto = JS_GetProperty(ctx, ctor, JS_ATOM_prototype);
20193.         if (JS_IsException(proto))
20194.             return proto;
20195.         if (!JS_IsObject(proto)) {
20196.             JS_FreeValue(ctx, proto);
20197.             realm = JS_GetFunctionRealm(ctx, ctor);
20198.             if (!realm)
20199.                 return JS_EXCEPTION;
20200.             proto = JS_DupValue(ctx, realm->class_proto[class_id]);
20201.         }
20202.     }
20203.     obj = JS_NewObjectProtoClass(ctx, proto, class_id);
20204.     JS_FreeValue(ctx, proto);
20205.     return obj;
20206. }

