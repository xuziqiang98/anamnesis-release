1734. static void *js_def_malloc(JSMallocState *s, size_t size)
1735. {
1736.     void *ptr;
1737. 
1738.     /* Do not allocate zero bytes: behavior is platform dependent */
1739.     assert(size != 0);
1740. 
1741.     if (unlikely(s->malloc_size + size > s->malloc_limit))
1742.         return NULL;
1743. 
1744.     ptr = malloc(size);
1745.     if (!ptr)
1746.         return NULL;
1747. 
1748.     s->malloc_count++;
1749.     s->malloc_size += js_def_malloc_usable_size(ptr) + MALLOC_OVERHEAD;
1750.     return ptr;
1751. }

