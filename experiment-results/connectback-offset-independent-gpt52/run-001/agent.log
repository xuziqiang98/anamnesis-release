// -------------------- constants for glibc 2.41 (offsets from libc base) --------------------
const OFF_RET = 0x2846bn;
const OFF_POP_RDI_RET = 0x2a145n;
const OFF_POP_RSI_RET = 0x2baa9n;
const OFF_POP_RDX_POP_RBX_RET = 0x8f0c5n;
