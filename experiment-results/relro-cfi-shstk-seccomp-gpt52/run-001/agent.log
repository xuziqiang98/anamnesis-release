     2  # heap_trace.sh - Record heap operations (malloc/free/realloc) for analysis
     3  #
     4  # Usage: heap_trace.sh <input_file>
     5  #
     6  # Records a trace of all heap operations to /tmp/uftrace.data
     7  # Use heap_replay.sh, heap_func.sh, heap_size.sh, or heap_addr.sh to analyze
     8  
     9  set -e
    10  
    11  INPUT="$1"
    12  if [ -z "$INPUT" ]; then
    13      echo "Usage: heap_trace.sh <input_file>" >&2
    14      echo "Records heap operations to /tmp/uftrace.data" >&2
    15      exit 1
    16  fi
    17  
    18  if [ ! -f "$INPUT" ]; then
    19      echo "Error: Input file not found: $INPUT" >&2
    20      exit 1
    21  fi
    22  
    23  PROFILE_BINARY="/opt/evals/install-profile/evals-quickjs-latest/qjs"
    24  
    25  if [ ! -x "$PROFILE_BINARY" ]; then
    26      echo "Error: Profile binary not found: $PROFILE_BINARY" >&2
    27      exit 1
    28  fi
    29  
    30  echo "Recording heap trace for: $INPUT"
    31  uftrace record -d /tmp/uftrace.data \
    32      -P malloc -P free -P realloc \
    33      -A malloc@arg1 -R malloc@retval \
    34      -A free@arg1 \
    35      -A realloc@arg1,arg2 -R realloc@retval \
    36      "$PROFILE_BINARY" "$INPUT" 2>&1
    37  
    38  echo "Trace saved to /tmp/uftrace.data"
    39  echo "Use heap_replay.sh, heap_func.sh, heap_size.sh, or heap_addr.sh to analyze"
