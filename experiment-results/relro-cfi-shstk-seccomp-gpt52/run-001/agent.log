56321. static BOOL typed_array_is_oob(JSObject *p)
56322. {
56323.     JSArrayBuffer *abuf;
56324.     JSTypedArray *ta;
56325.     int len, size_elem;
56326.     int64_t end;
56327. 
56328.     assert(p->class_id >= JS_CLASS_UINT8C_ARRAY);
56329.     assert(p->class_id <= JS_CLASS_FLOAT64_ARRAY);
56330. 
56331.     ta = p->u.typed_array;
56332.     abuf = ta->buffer->u.array_buffer;
56333.     if (abuf->detached)
56334.         return TRUE;
56335.     len = abuf->byte_length;
56336.     if (ta->offset > len)
56337.         return TRUE;
56338.     if (ta->track_rab)
56339.         return FALSE;
56340.     if (len < (int64_t)ta->offset + ta->length)
56341.         return TRUE;
56342.     size_elem = 1 << typed_array_size_log2(p->class_id);
56343.     end = (int64_t)ta->offset + (int64_t)p->u.array.count * size_elem;
56344.     return end > len;
56345. }

