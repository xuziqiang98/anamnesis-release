56161. static JSValue js_array_buffer_resize(JSContext *ctx, JSValueConst this_val,
56162.                                       int argc, JSValueConst *argv, int class_id)
56163. {
56164.     JSArrayBuffer *abuf;
56165.     uint8_t *data;
56166.     int64_t len;
56167. 
56168.     abuf = JS_GetOpaque2(ctx, this_val, class_id);
56169.     if (!abuf)
56170.         return JS_EXCEPTION;
56171.     if (JS_ToInt64(ctx, &len, argv[0]))
56172.         return JS_EXCEPTION;
56173.     if (abuf->detached)
56174.         return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
56175.     if (!array_buffer_is_resizable(abuf))
56176.         return JS_ThrowTypeError(ctx, "array buffer is not resizable");
56177.     // TODO(bnoordhuis) support externally managed RABs
56178.     if (abuf->free_func != js_array_buffer_free)
56179.         return JS_ThrowTypeError(ctx, "external array buffer is not resizable");
56180.     if (len < 0 || len > abuf->max_byte_length) {
56181.     bad_length:
56182.         return JS_ThrowRangeError(ctx, "invalid array buffer length");
56183.     }
56184.     // SABs can only grow and we don't need to realloc because
56185.     // js_array_buffer_constructor3 commits all memory upfront;
56186.     // regular RABs are resizable both ways and realloc
56187.     if (abuf->shared) {
56188.         if (len < abuf->byte_length)
56189.             goto bad_length;
56190.         // Note this is off-spec; there's supposed to be a single atomic
56191.         // |byteLength| property that's shared across SABs but we store
56192.         // it per SAB instead. That means when thread A calls sab.grow(2)
56193.         // at time t0, and thread B calls sab.grow(1) at time t1, we don't
56194.         // throw a TypeError in thread B as the spec says we should,
56195.         // instead both threads get their own view of the backing memory,
56196.         // 2 bytes big in A, and 1 byte big in B
56197.         abuf->byte_length = len;
56198.     } else {
56199.         data = js_realloc(ctx, abuf->data, max_int(len, 1));
56200.         if (!data)
56201.             return JS_EXCEPTION;
56202.         if (len > abuf->byte_length)
56203.             memset(&data[abuf->byte_length], 0, len - abuf->byte_length);
56204.         abuf->byte_length = len;
56205.         abuf->data = data;
56206.     }
56207.     js_array_buffer_update_typed_arrays(abuf);
56208.     return JS_UNDEFINED;
56209. }

