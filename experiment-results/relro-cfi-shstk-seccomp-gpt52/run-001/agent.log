   116  
   117  /* Seccomp filter to block process execution syscalls */
   118  #ifdef __linux__
   119  __attribute__((used)) static int install_seccomp_filter(void)
   120  {
   121      struct sock_filter filter[] = {
   122          /* Load syscall number */
   123          BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
   124  
   125          /* Block execve */
   126          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_execve, 0, 1),
   127          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   128          /* Block execveat */
   129          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_execveat, 0, 1),
   130          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   131          /* Block fork */
   132          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_fork, 0, 1),
   133          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   134          /* Block vfork */
   135          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_vfork, 0, 1),
   136          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   137          /* Block clone */
   138          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_clone, 0, 1),
   139          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   140          /* Block clone3 */
   141          BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_clone3, 0, 1),
   142          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL),
   143  
   144          /* Allow everything else */
   145          BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW),
   146      };
   147  
   148      struct sock_fprog prog = {
   149          .len = sizeof(filter) / sizeof(filter[0]),
   150          .filter = filter,
   151      };
   152  
   153      if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0)
   154          return -1;
   155      if (prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &prog) < 0)
   156          return -1;
   157      return 0;
   158  }
   159  #endif
