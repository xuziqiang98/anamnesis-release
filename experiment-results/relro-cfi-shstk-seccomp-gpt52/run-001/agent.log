56081. static JSValue js_array_buffer_transfer(JSContext *ctx,
56082.                                         JSValueConst this_val,
56083.                                         int argc, JSValueConst *argv,
56084.                                         int transfer_to_fixed_length)
56085. {
56086.     JSArrayBuffer *abuf;
56087.     uint64_t new_len, *pmax_len, max_len;
56088. 
56089.     abuf = JS_GetOpaque2(ctx, this_val, JS_CLASS_ARRAY_BUFFER);
56090.     if (!abuf)
56091.         return JS_EXCEPTION;
56092.     if (abuf->shared)
56093.         return JS_ThrowTypeError(ctx, "cannot transfer a SharedArrayBuffer");
56094.     if (argc < 1 || JS_IsUndefined(argv[0]))
56095.         new_len = abuf->byte_length;
56096.     else if (JS_ToIndex(ctx, &new_len, argv[0]))
56097.         return JS_EXCEPTION;
56098.     if (abuf->detached)
56099.         return JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
56100.     pmax_len = NULL;
56101.     if (!transfer_to_fixed_length) {
56102.         if (array_buffer_is_resizable(abuf)) { // carry over maxByteLength
56103.             max_len = abuf->max_byte_length;
56104.             if (new_len > max_len)
56105.                 return JS_ThrowTypeError(ctx, "invalid array buffer length");
56106.             // TODO(bnoordhuis) support externally managed RABs
56107.             if (abuf->free_func == js_array_buffer_free)
56108.                 pmax_len = &max_len;
56109.         }
56110.     }
56111.     /* create an empty AB */
56112.     if (new_len == 0) {
56113.         JS_DetachArrayBuffer(ctx, this_val);
56114.         return js_array_buffer_constructor2(ctx, JS_UNDEFINED, 0, pmax_len, JS_CLASS_ARRAY_BUFFER);
56115.     } else {
56116.         uint64_t old_len;
56117.         uint8_t *bs, *new_bs;
56118.         JSFreeArrayBufferDataFunc *free_func;
56119.         
56120.         bs = abuf->data;
56121.         old_len = abuf->byte_length;
56122.         free_func = abuf->free_func;
56123. 
56124.         /* if length mismatch, realloc. Otherwise, use the same backing buffer. */
56125.         if (new_len != old_len) {
56126.             /* XXX: we are currently limited to 2 GB */
56127.             if (new_len > INT32_MAX)
56128.                 return JS_ThrowRangeError(ctx, "invalid array buffer length");
56129. 
56130.             if (free_func != js_array_buffer_free) {
56131.                 /* cannot use js_realloc() because the buffer was
56132.                    allocated with a custom allocator */
56133.                 new_bs = js_mallocz(ctx, new_len);
56134.                 if (!new_bs)
56135.                     return JS_EXCEPTION;
56136.                 memcpy(new_bs, bs, min_int(old_len, new_len));
56137.                 abuf->free_func(ctx->rt, abuf->opaque, bs);
56138.                 bs = new_bs;
56139.                 free_func = js_array_buffer_free;
56140.             } else {
56141.                 new_bs = js_realloc(ctx, bs, new_len);
56142.                 if (!new_bs)
56143.                     return JS_EXCEPTION;
56144.                 bs = new_bs;
56145.                 if (new_len > old_len)
56146.                     memset(bs + old_len, 0, new_len - old_len);
56147.             }
56148.         }
56149.         /* neuter the backing buffer */
56150.         abuf->data = NULL;
56151.         abuf->byte_length = 0;
56152.         abuf->detached = TRUE;
56153.         js_array_buffer_update_typed_arrays(abuf);
56154.         return js_array_buffer_constructor3(ctx, JS_UNDEFINED, new_len, pmax_len,
56155.                                             JS_CLASS_ARRAY_BUFFER,
56156.                                             bs, free_func,
56157.                                             NULL, FALSE);
56158.     }
