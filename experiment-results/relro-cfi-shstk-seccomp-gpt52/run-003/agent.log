  1763  static JSValue js_os_seek(JSContext *ctx, JSValueConst this_val,
  1764                            int argc, JSValueConst *argv)
  1765  {
  1766      int fd, whence;
  1767      int64_t pos, ret;
  1768      BOOL is_bigint;
  1769  
  1770      if (JS_ToInt32(ctx, &fd, argv[0]))
  1771          return JS_EXCEPTION;
  1772      is_bigint = JS_IsBigInt(ctx, argv[1]);
  1773      if (JS_ToInt64Ext(ctx, &pos, argv[1]))
  1774          return JS_EXCEPTION;
  1775      if (JS_ToInt32(ctx, &whence, argv[2]))
  1776          return JS_EXCEPTION;
  1777      ret = lseek(fd, pos, whence);
  1778      if (ret == -1)
  1779          ret = -errno;
  1780      if (is_bigint)
