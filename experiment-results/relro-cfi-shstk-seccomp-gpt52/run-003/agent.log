  1786  static JSValue js_os_read_write(JSContext *ctx, JSValueConst this_val,
  1787                                  int argc, JSValueConst *argv, int magic)
  1788  {
  1789      int fd;
  1790      uint64_t pos, len;
  1791      size_t size;
  1792      ssize_t ret;
  1793      uint8_t *buf;
  1794  
  1795      if (JS_ToInt32(ctx, &fd, argv[0]))
  1796          return JS_EXCEPTION;
  1797      if (JS_ToIndex(ctx, &pos, argv[2]))
  1798          return JS_EXCEPTION;
  1799      if (JS_ToIndex(ctx, &len, argv[3]))
  1800          return JS_EXCEPTION;
  1801      buf = JS_GetArrayBuffer(ctx, &size, argv[1]);
  1802      if (!buf)
  1803          return JS_EXCEPTION;
  1804      if (pos + len > size)
  1805          return JS_ThrowRangeError(ctx, "read/write array buffer overflow");
