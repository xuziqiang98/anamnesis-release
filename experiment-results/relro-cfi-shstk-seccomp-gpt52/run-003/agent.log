   211      js_trace_malloc_printf(JSMallocState *s, const char *fmt, ...)
   212  {
   213      va_list ap;
   214      int c;
   215  
   216      va_start(ap, fmt);
   217      while ((c = *fmt++) != '\0') {
   218          if (c == '%') {
   219              /* only handle %p and %zd */
   220              if (*fmt == 'p') {
   221                  uint8_t *ptr = va_arg(ap, void *);
   222                  if (ptr == NULL) {
   223                      printf("NULL");
   224                  } else {
   225                      printf("H%+06lld.%zd",
   226                             js_trace_malloc_ptr_offset(ptr, s->opaque),
   227                             js_trace_malloc_usable_size(ptr));
   228                  }
   229                  fmt++;
   230                  continue;
   231              }
   232              if (fmt[0] == 'z' && fmt[1] == 'd') {
   233                  size_t sz = va_arg(ap, size_t);
   234                  printf("%zd", sz);
   235                  fmt += 2;
   236                  continue;
   237              }
   238          }
   239          putc(c, stdout);
   240      }
   241      va_end(ap);
   242  }
