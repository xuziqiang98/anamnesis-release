  1722  
  1723  static JSValue js_os_open(JSContext *ctx, JSValueConst this_val,
  1724                            int argc, JSValueConst *argv)
  1725  {
  1726      const char *filename;
  1727      int flags, mode, ret;
  1728  
  1729      filename = JS_ToCString(ctx, argv[0]);
  1730      if (!filename)
  1731          return JS_EXCEPTION;
  1732      if (JS_ToInt32(ctx, &flags, argv[1]))
  1733          goto fail;
  1734      if (argc >= 3 && !JS_IsUndefined(argv[2])) {
  1735          if (JS_ToInt32(ctx, &mode, argv[2])) {
  1736          fail:
  1737              JS_FreeCString(ctx, filename);
  1738              return JS_EXCEPTION;
  1739          }
  1740      } else {
  1741          mode = 0666;
  1742      }
  1743  #if defined(_WIN32)
  1744      /* force binary mode by default */
  1745      if (!(flags & O_TEXT))
  1746          flags |= O_BINARY;
  1747  #endif
  1748      ret = js_get_errno(open(filename, flags, mode));
  1749      JS_FreeCString(ctx, filename);
  1750      return JS_NewInt32(ctx, ret);
  1751  }
