    58  static int eval_buf(JSContext *ctx, const void *buf, int buf_len,
    59                      const char *filename, int eval_flags)
    60  {
    61      JSValue val;
    62      int ret;
    63  
    64      if ((eval_flags & JS_EVAL_TYPE_MASK) == JS_EVAL_TYPE_MODULE) {
    65          /* for the modules, we compile then run to be able to set
    66             import.meta */
    67          val = JS_Eval(ctx, buf, buf_len, filename,
    68                        eval_flags | JS_EVAL_FLAG_COMPILE_ONLY);
    69          if (!JS_IsException(val)) {
    70              js_module_set_import_meta(ctx, val, TRUE, TRUE);
    71              val = JS_EvalFunction(ctx, val);
    72          }
    73          val = js_std_await(ctx, val);
    74      } else {
    75          val = JS_Eval(ctx, buf, buf_len, filename, eval_flags);
    76      }
    77      if (JS_IsException(val)) {
    78          js_std_dump_error(ctx);
    79          ret = -1;
    80      } else {
    81          ret = 0;
    82      }
    83      JS_FreeValue(ctx, val);
    84      return ret;
    85  }
    86  
    87  static int eval_file(JSContext *ctx, const char *filename, int module, int strict)
    88  {
    89      uint8_t *buf;
    90      int ret, eval_flags;
    91      size_t buf_len;
    92  
    93      buf = js_load_file(ctx, &buf_len, filename);
    94      if (!buf) {
    95          perror(filename);
    96          exit(1);
    97      }
    98  
    99      if (module < 0) {
   100          module = (has_suffix(filename, ".mjs") ||
