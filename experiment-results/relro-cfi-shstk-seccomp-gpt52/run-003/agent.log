    79    /* Setup rbx.*/
    80    ucp->uc_mcontext.gregs[REG_RBX] = (uintptr_t) &sp[idx_uc_link];
    81    ucp->uc_mcontext.gregs[REG_RSP] = (uintptr_t) sp;
    82  
    83    /* Setup stack.  */
    84  #if SHSTK_ENABLED
