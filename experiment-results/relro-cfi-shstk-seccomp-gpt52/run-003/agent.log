    33     __libc_lock_lock (__exit_funcs_lock);
    34    new = __new_exitfn (&__exit_funcs);
    35  
    36    if (new == NULL)
    37      {
    38        __libc_lock_unlock (__exit_funcs_lock);
    39        return -1;
    40      }
    41  
    42    PTR_MANGLE (func);
    43    new->func.on.fn = func;
    44    new->func.on.arg = arg;
    45    new->flavor = ef_on;
    46    __libc_lock_unlock (__exit_funcs_lock);
    47    return 0;
    48  }
