55876.     JSArrayBuffer *abuf = p->u.array_buffer;
55877.     struct list_head *el, *el1;
55878. 
55879.     if (abuf) {
55880.         /* The ArrayBuffer finalizer may be called before the typed
55881.            array finalizers using it, so abuf->array_list is not
55882.            necessarily empty. */
55883.         list_for_each_safe(el, el1, &abuf->array_list) {
55884.             JSTypedArray *ta;
55885.             JSObject *p1;
55886. 
55887.             ta = list_entry(el, JSTypedArray, link);
55888.             ta->link.prev = NULL;
55889.             ta->link.next = NULL;
55890.             p1 = ta->obj;
55891.             /* Note: the typed array length and offset fields are not modified */
55892.             if (p1->class_id != JS_CLASS_DATAVIEW) {
55893.                 p1->u.array.count = 0;
55894.                 p1->u.array.u.ptr = NULL;
55895.             }
55896.         }
55897.         if (abuf->shared && rt->sab_funcs.sab_free) {
55898.             rt->sab_funcs.sab_free(rt->sab_funcs.sab_opaque, abuf->data);
55899.         } else {
