   399          goto fail;
   400      lret = ftell(f);
   401      if (lret < 0)
   402          goto fail;
   403      /* XXX: on Linux, ftell() return LONG_MAX for directories */
   404      if (lret == LONG_MAX) {
   405          errno = EISDIR;
   406          goto fail;
   407      }
