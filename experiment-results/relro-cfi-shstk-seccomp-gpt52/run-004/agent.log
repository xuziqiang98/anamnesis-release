4025.             putchar(' ');
4026.         v = argv[i];
4027.         if (JS_IsString(v)) {
4028.             const char *str;
4029.             size_t len;
4030.             str = JS_ToCStringLen(ctx, &len, v);
4031.             if (!str)
4032.                 return JS_EXCEPTION;
4033.             fwrite(str, 1, len, stdout);
4034.             JS_FreeCString(ctx, str);
4035.         } else {
4036.             JS_PrintValue(ctx, js_print_value_write, stdout, v, NULL);
4037.         }
4038.     }
4039.     putchar('\n');
4040.     return JS_UNDEFINED;
4041. }

