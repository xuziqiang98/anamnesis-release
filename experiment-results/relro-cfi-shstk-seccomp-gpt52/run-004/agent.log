58657.                               void **pptr,
58658.                               JSArrayBuffer **pabuf,
58659.                               int *psize_log2, JSClassID *pclass_id,
58660.                               JSValueConst obj, JSValueConst idx_val,
58661.                               int is_waitable)
58662. {
58663.     JSObject *p;
58664.     JSTypedArray *ta;
58665.     JSArrayBuffer *abuf;
58666.     void *ptr;
58667.     uint64_t idx;
58668.     BOOL err;
58669.     int size_log2, old_len;
58670. 
58671.     if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
58672.         goto fail;
58673.     p = JS_VALUE_GET_OBJ(obj);
58674.     if (is_waitable)
58675.         err = (p->class_id != JS_CLASS_INT32_ARRAY &&
58676.                p->class_id != JS_CLASS_BIG_INT64_ARRAY);
58677.     else
