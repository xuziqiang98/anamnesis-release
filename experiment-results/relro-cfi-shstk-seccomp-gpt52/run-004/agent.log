58685.     ta = p->u.typed_array;
58686.     abuf = ta->buffer->u.array_buffer;
58687.     if (!abuf->shared) {
58688.         if (is_waitable == 2) {
58689.             JS_ThrowTypeError(ctx, "not a SharedArrayBuffer TypedArray");
58690.             return -1;
58691.         }
58692.         if (abuf->detached) {
58693.             JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
58694.             return -1;
58695.         }
58696.     }
58697.     old_len = p->u.array.count;
58698.     
58699.     if (JS_ToIndex(ctx, &idx, idx_val)) {
58700.         return -1;
58701.     }
58702. 
58703.     if (idx >= old_len)
58704.         goto oob;
58705. 
58706.     if (is_waitable == 1) {
58707.         /* notify(): just avoid having an invalid pointer if overflow */
58708.         if (idx >= p->u.array.count)
58709.             ptr = NULL;
58710.     } else {
58711.         /* RevalidateAtomicAccess() */
58712.         if (typed_array_is_oob(p)) {
58713.             JS_ThrowTypeErrorArrayBufferOOB(ctx);
58714.             return -1;
58715.         }
58716.         if (idx >= p->u.array.count) {
58717.         oob:
58718.             JS_ThrowRangeError(ctx, "out-of-bound access");
58719.             return -1;
58720.         }
58721.     }
58722. 
58723.     size_log2 = typed_array_size_log2(p->class_id);
58724.     ptr = p->u.array.u.uint8_ptr + ((uintptr_t)idx << size_log2);
58725.     if (pabuf)
58726.         *pabuf = abuf;
58727.     if (psize_log2)
58728.         *psize_log2 = size_log2;
