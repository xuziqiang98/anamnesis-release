int
_IO_wdefault_doallocate (FILE *fp)
{
  wchar_t *buf = (wchar_t *)malloc (BUFSIZ);
  if (__glibc_unlikely (buf == NULL))
    return EOF;

  _IO_wsetb (fp, buf, buf + BUFSIZ / sizeof *buf, 1);
  return 1;
}
