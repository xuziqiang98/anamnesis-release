56193.         // at time t0, and thread B calls sab.grow(1) at time t1, we don't
56194.         // throw a TypeError in thread B as the spec says we should,
56195.         // instead both threads get their own view of the backing memory,
56196.         // 2 bytes big in A, and 1 byte big in B
56197.         abuf->byte_length = len;
