55702. static JSValue js_array_buffer_constructor3(JSContext *ctx,
55703.                                             JSValueConst new_target,
55704.                                             uint64_t len, uint64_t *max_len,
55705.                                             JSClassID class_id,
55706.                                             uint8_t *buf,
55707.                                             JSFreeArrayBufferDataFunc *free_func,
55708.                                             void *opaque, BOOL alloc_flag)
55709. {
55710.     JSRuntime *rt = ctx->rt;
55711.     JSValue obj;
55712.     JSArrayBuffer *abuf = NULL;
55713.     uint64_t sab_alloc_len;
55714. 
55715.     if (!alloc_flag && buf && max_len && free_func != js_array_buffer_free) {
55716.         // not observable from JS land, only through C API misuse;
55717.         // JS code cannot create externally managed buffers directly
55718.         return JS_ThrowInternalError(ctx,
55719.                                      "resizable ArrayBuffers not supported "
55720.                                      "for externally managed buffers");
55721.     }
55722.     obj = js_create_from_ctor(ctx, new_target, class_id);
55723.     if (JS_IsException(obj))
55724.         return obj;
55725.     /* XXX: we are currently limited to 2 GB */
55726.     if (len > INT32_MAX) {
55727.         JS_ThrowRangeError(ctx, "invalid array buffer length");
55728.         goto fail;
55729.     }
55730.     if (max_len && *max_len > INT32_MAX) {
55731.         JS_ThrowRangeError(ctx, "invalid max array buffer length");
55732.         goto fail;
55733.     }
55734.     abuf = js_malloc(ctx, sizeof(*abuf));
55735.     if (!abuf)
55736.         goto fail;
55737.     abuf->byte_length = len;
55738.     abuf->max_byte_length = max_len ? *max_len : -1;
55739.     if (alloc_flag) {
55740.         if (class_id == JS_CLASS_SHARED_ARRAY_BUFFER &&
55741.             rt->sab_funcs.sab_alloc) {
55742.             // TOOD(bnoordhuis) resizing backing memory for SABs atomically
55743.             // is hard so we cheat and allocate |maxByteLength| bytes upfront
55744.             sab_alloc_len = max_len ? *max_len : len;
55745.             abuf->data = rt->sab_funcs.sab_alloc(rt->sab_funcs.sab_opaque,
55746.                                                  max_int(sab_alloc_len, 1));
55747.             if (!abuf->data)
55748.                 goto fail;
55749.             memset(abuf->data, 0, sab_alloc_len);
55750.         } else {
55751.             /* the allocation must be done after the object creation */
55752.             abuf->data = js_mallocz(ctx, max_int(len, 1));
55753.             if (!abuf->data)
55754.                 goto fail;
55755.         }
55756.     } else {
55757.         if (class_id == JS_CLASS_SHARED_ARRAY_BUFFER &&
55758.             rt->sab_funcs.sab_dup) {
55759.             rt->sab_funcs.sab_dup(rt->sab_funcs.sab_opaque, buf);
55760.         }
55761.         abuf->data = buf;
55762.     }
55763.     init_list_head(&abuf->array_list);
55764.     abuf->detached = FALSE;
55765.     abuf->shared = (class_id == JS_CLASS_SHARED_ARRAY_BUFFER);
55766.     abuf->opaque = opaque;
55767.     abuf->free_func = free_func;
55768.     if (alloc_flag && buf)
55769.         memcpy(abuf->data, buf, len);
55770.     JS_SetOpaque(obj, abuf);
55771.     return obj;
55772.  fail:
55773.     JS_FreeValue(ctx, obj);
55774.     js_free(ctx, abuf);
55775.     return JS_EXCEPTION;
55776. }

