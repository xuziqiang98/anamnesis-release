388. uint8_t *js_load_file(JSContext *ctx, size_t *pbuf_len, const char *filename)
389. {
390.     FILE *f;
391.     uint8_t *buf;
392.     size_t buf_len;
393.     long lret;
394. 
395.     f = fopen(filename, "rb");
396.     if (!f)
397.         return NULL;
398.     if (fseek(f, 0, SEEK_END) < 0)
399.         goto fail;
400.     lret = ftell(f);
401.     if (lret < 0)
402.         goto fail;
403.     /* XXX: on Linux, ftell() return LONG_MAX for directories */
404.     if (lret == LONG_MAX) {
405.         errno = EISDIR;
406.         goto fail;
407.     }
408.     buf_len = lret;
409.     if (fseek(f, 0, SEEK_SET) < 0)
410.         goto fail;
411.     if (ctx)
412.         buf = js_malloc(ctx, buf_len + 1);
413.     else
414.         buf = malloc(buf_len + 1);
415.     if (!buf)
416.         goto fail;
417.     if (fread(buf, 1, buf_len, f) != buf_len) {
418.         errno = EIO;
419.         if (ctx)
420.             js_free(ctx, buf);
421.         else
422.             free(buf);
423.     fail:
424.         fclose(f);
425.         return NULL;
426.     }
427.     buf[buf_len] = '\0';
428.     fclose(f);
429.     *pbuf_len = buf_len;
430.     return buf;
431. }

