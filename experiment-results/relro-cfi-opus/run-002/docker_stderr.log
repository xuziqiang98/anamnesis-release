```c
struct JSObject {
    ...
    union {
        ...
        struct { /* array */
            union { uint32_t size; struct JSTypedArray *typed_array; } u1;
            union { ... uint8_t *uint8_ptr; ... } u;  // offset 40
            uint32_t count;  // offset 48
        } array;
        ...
    } u;  // offset 32
};
```

