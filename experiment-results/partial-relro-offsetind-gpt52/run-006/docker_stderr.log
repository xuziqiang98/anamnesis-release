#!/bin/bash
# heap_addr.sh - Track what happens to a specific memory address
#
# Usage: heap_addr.sh <address>
#
# Shows all malloc/free/realloc operations involving the specified address,
# along with the call stack at each operation.
#
# Example: heap_addr.sh 0x55e62a389120
#
# Run heap_trace.sh first to record a trace

ADDR="$1"
if [ -z "$ADDR" ]; then
    echo "Usage: heap_addr.sh <address>" >&2
    echo "Shows all heap operations involving the specified address with call stacks" >&2
    exit 1
fi

if [ ! -d "/tmp/uftrace.data" ]; then
    echo "Error: No trace data found. Run heap_trace.sh first." >&2
    exit 1
fi

# Use awk to track the call stack and print it when we see the address
uftrace replay -d /tmp/uftrace.data 2>&1 | awk -v addr="$ADDR" '
$0 ~ addr {
    # Print call stack
    print "=== Call stack ==="
    for (i = 0; i < depth; i++) {
        print prefix[i] stack[i]
    }
    print $0
    print ""
}
/\(\) \{$/ {
    # Extract function name and add to stack
    match($0, /[a-zA-Z_][a-zA-Z0-9_]*\(\)/)
    stack[depth] = substr($0, RSTART, RLENGTH)
    # Capture indentation for pretty printing
    match($0, /^[^a-zA-Z]*/)
    prefix[depth] = substr($0, RSTART, RLENGTH)
    depth++
}
/\} \/\*/ {
    # Pop from stack
    if (depth > 0) depth--
}'

