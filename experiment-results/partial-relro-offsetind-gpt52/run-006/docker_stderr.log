9042.            array */
9043.         JS_ToUint32(ctx, &cur_len, p->prop[0].u.value);
9044.         if (len < cur_len) {
9045.             uint32_t d;
9046.             JSShape *sh;
9047.             JSShapeProperty *pr;
9048. 
