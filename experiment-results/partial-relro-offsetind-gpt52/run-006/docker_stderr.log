9050.             sh = p->shape;
9051.             if (d <= sh->prop_count) {
9052.                 JSAtom atom;
9053. 
9054.                 /* faster to iterate */
9055.                 while (cur_len > len) {
9056.                     atom = JS_NewAtomUInt32(ctx, cur_len - 1);
9057.                     ret = delete_property(ctx, p, atom);
9058.                     JS_FreeAtom(ctx, atom);
9059.                     if (unlikely(!ret)) {
9060.                         /* unlikely case: property is not
9061.                            configurable */
9062.                         break;
9063.                     }
9064.                     cur_len--;
9065.                 }
9066.             } else {
9067.                 /* faster to iterate thru all the properties. Need two
9068.                    passes in case one of the property is not
9069.                    configurable */
