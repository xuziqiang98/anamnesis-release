55974. static void js_array_buffer_update_typed_arrays(JSArrayBuffer *abuf)
55975. {
55976.     uint32_t size_log2, size_elem;
55977.     struct list_head *el;
55978.     JSTypedArray *ta;
55979.     JSObject *p;
55980.     uint8_t *data;
55981.     int64_t len;
55982. 
55983.     len = abuf->byte_length;
55984.     data = abuf->data;
