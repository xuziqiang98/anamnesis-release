58646. static int js_atomics_get_ptr(JSContext *ctx,
58647.                               void **pptr,
58648.                               JSArrayBuffer **pabuf,
58649.                               int *psize_log2, JSClassID *pclass_id,
58650.                               JSValueConst obj, JSValueConst idx_val,
58651.                               int is_waitable)
58652. {
58653.     JSObject *p;
58654.     JSTypedArray *ta;
58655.     JSArrayBuffer *abuf;
58656.     void *ptr;
58657.     uint64_t idx;
58658.     BOOL err;
58659.     int size_log2, old_len;
58660. 
58661.     if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT)
58662.         goto fail;
58663.     p = JS_VALUE_GET_OBJ(obj);
58664.     if (is_waitable)
58665.         err = (p->class_id != JS_CLASS_INT32_ARRAY &&
58666.                p->class_id != JS_CLASS_BIG_INT64_ARRAY);
58667.     else
58668.         err = !(p->class_id >= JS_CLASS_INT8_ARRAY &&
58669.                 p->class_id <= JS_CLASS_BIG_UINT64_ARRAY);
58670.     if (err) {
58671.     fail:
58672.         JS_ThrowTypeError(ctx, "integer TypedArray expected");
58673.         return -1;
58674.     }
58675.     ta = p->u.typed_array;
58676.     abuf = ta->buffer->u.array_buffer;
58677.     if (!abuf->shared) {
58678.         if (is_waitable == 2) {
58679.             JS_ThrowTypeError(ctx, "not a SharedArrayBuffer TypedArray");
58680.             return -1;
58681.         }
58682.         if (abuf->detached) {
58683.             JS_ThrowTypeErrorDetachedArrayBuffer(ctx);
58684.             return -1;
58685.         }
58686.     }
58687.     old_len = p->u.array.count;
58688.     
58689.     if (JS_ToIndex(ctx, &idx, idx_val)) {
58690.         return -1;
58691.     }
58692. 
58693.     if (idx >= old_len)
58694.         goto oob;
58695. 
58696.     if (is_waitable == 1) {
58697.         /* notify(): just avoid having an invalid pointer if overflow */
58698.         if (idx >= p->u.array.count)
58699.             ptr = NULL;
58700.     } else {
58701.         /* RevalidateAtomicAccess() */
58702.         if (typed_array_is_oob(p)) {
58703.             JS_ThrowTypeErrorArrayBufferOOB(ctx);
58704.             return -1;
58705.         }
58706.         if (idx >= p->u.array.count) {
58707.         oob:
58708.             JS_ThrowRangeError(ctx, "out-of-bound access");
58709.             return -1;
58710.         }
58711.     }
58712. 
58713.     size_log2 = typed_array_size_log2(p->class_id);
58714.     ptr = p->u.array.u.uint8_ptr + ((uintptr_t)idx << size_log2);
58715.     if (pabuf)
58716.         *pabuf = abuf;
58717.     if (psize_log2)
58718.         *psize_log2 = size_log2;
58719.     if (pclass_id)
58720.         *pclass_id = p->class_id;
58721.     *pptr = ptr;
58722.     return 0;
58723. }

